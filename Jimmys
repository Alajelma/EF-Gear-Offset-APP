function renderChefStatsTable(){const rows={}; state.orders.forEach(o=>{const q=quarter(o.createdAt?.slice(0,10)); rows[q]=rows[q]||{orders:0,done:0,meters:0,complaints:0,open:0}; rows[q].orders++; if(o.status==='Abgeschlossen')rows[q].done++; else rows[q].open++; rows[q].meters+=Number(o.runningMeters||0); if(o.complaint||o.status==='Reklamation')rows[q].complaints++}); document.getElementById('chefStatsTable').innerHTML=`<table class="compact-table"><thead><tr><th>Quartal</th><th>Aufträge</th><th>Offen</th><th>Abgeschlossen</th><th>Laufmeter</th><th>Reklamationen</th></tr></thead><tbody>${Object.entries(rows).sort().map(([q,r])=>`<tr><td><b>${esc(q)}</b></td><td>${r.orders}</td><td>${r.open}</td><td>${r.done}</td><td>${r.meters.toFixed(1)}</td><td>${r.complaints}</td></tr>`).join('')||'<tr><td colspan="6">Noch keine Daten vorhanden.</td></tr>'}</tbody></table>`}
