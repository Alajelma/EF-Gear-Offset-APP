      firstCard.insertAdjacentHTML('beforeend',`<div id="outlookExportInfo" class="outlook-export-card no-print"><div><b>Outlook-Export gesamte Wochenplanung</b><br><span class="small">Exportiert alle geplanten Mitarbeiter-Aufträge und Abwesenheiten im sichtbaren Zeitraum. Die ICS-Datei kann in Outlook per Drag-and-drop importiert werden. Farben werden über Kategorien mitgegeben.</span></div><div class="mini-grid"><div class="mini-box"><span class="cat-dot cat-plan"></span>Geplant</div><div class="mini-box"><span class="cat-dot cat-work"></span>In Arbeit</div><div class="mini-box"><span class="cat-dot cat-complaint"></span>Reklamation</div><div class="mini-box"><span class="cat-dot cat-absence"></span>Abwesenheit</div></div><div class="toolbar"><button class="btn-primary" onclick="exportPlannerOutlookICS()">ICS für Outlook herunterladen</button><button onclick="exportPlannerOutlookOverview()">Farbige HTML-Übersicht</button><button onclick="exportPlannerOutlookPack()">Paket ICS + Übersicht</button></div></div>`);
    }
  }
  const oldRenderPlanner=window.renderPlanner;
  window.renderPlanner=function(){
    const result=oldRenderPlanner&&oldRenderPlanner.apply(this,arguments);
    injectPlannerOutlookControls();
    return result;
  };
  const oldShowTab=window.showTab;
  window.showTab=function(id){
    const result=oldShowTab&&oldShowTab.apply(this,arguments);
    if(id==='planner')injectPlannerOutlookControls();
    if(id==='chef')setTimeout(()=>triggerBirthdayAnimation(false),80);
    return result;
  };
  const oldRenderBackupInfo=window.renderBackupInfo;
  window.renderBackupInfo=function(){
    oldRenderBackupInfo&&oldRenderBackupInfo.apply(this,arguments);
    const el=document.getElementById('backupInfo');
    if(el && !el.querySelector('.v31backup')){
      el.insertAdjacentHTML('beforeend',`<div class="order-card v31backup"><b>Zusatzlogik v3.1</b><br>Geburtstagsanimation maximal 2× pro Tag · Outlook-ICS für gesamte Wochenplanung · Kategorien für Farben in Outlook</div>`);
    }
  };
  setTimeout(()=>{setAppVersionV31();injectV31Styles();injectPlannerOutlookControls();renderBackupInfo&&renderBackupInfo();},350);
})();
}catch(e){console.warn("IIFE Patch Fehler:",e);}


// Direkt aufrufen – Script ist am Ende des Body, DOM ist bereits bereit
init();
</script>

