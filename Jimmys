function materialQtySuggestion(order,mat){
  const lm=Math.max(0,Number(order.runningMeters||0));
  const cat=order.category||'';
  const name=(mat?.name||'').toLowerCase();
  if(cat==='Silikonfugen'||cat==='Spezialfugen'||cat==='Reparatur'||cat==='Reklamation'){
    if(name.includes('silikon')) return Math.max(1,Math.ceil(lm/6));
    if(name.includes('fugenband')||name.includes('hinterfüll')) return Math.max(1,Math.ceil(lm/20));
    if(name.includes('abdeckband')) return Math.max(1,Math.ceil(lm/50));
    if(name.includes('glätt')) return Math.max(1,Math.ceil(lm/120));
    if(name.includes('reinigung')) return Math.max(1,Math.ceil(lm/80));
  }
  if(cat==='Brandschutz'){
    if(name.includes('brandschutzsilikon')||name.includes('brandschutz acryl')) return Math.max(1,Math.ceil(lm/5));
    if(name.includes('mörtel')) return Math.max(1,Math.ceil(lm/25));
    if(name.includes('mineralwolle')) return Math.max(1,Math.ceil(lm/30));
    if(name.includes('manschette')) return Math.max(1,Math.ceil(lm/10));
    if(name.includes('etiketten')) return Math.max(1,Math.ceil((lm||1)/10));
  }
  return Math.max(1,Number(mat?.defaultQty||1));
}
function autoMaterialPlan(order,materials=[]){
  let list=(materials||[]).filter(x=>x&&x.id);
  if(!list.length){
    const pool=state.materials.filter(m=>m.active&&m.category===order.category);
    const pick=pool.filter(m=>/(silikon|acryl|abdeckband|fugenband|hinterfüll|glätt|reinigung|mörtel|mineralwolle|manschette|etiketten)/i.test(m.name)).slice(0,4);
    list=(pick.length?pick:pool.slice(0,3)).map(m=>({id:m.id,qty:0}));
  }
  return list.map(x=>{const m=getMaterial(x.id); const qty=Number(x.qty||0)>0?Number(x.qty):materialQtySuggestion(order,m); return {id:x.id,qty};});
}
