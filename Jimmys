<style id="mob-style">
@media(max-width:800px){
  .tabs{display:none!important}
  body.mob-home-open{overflow:hidden!important}
}
@media(min-width:801px){ #mobOv,#mobHomeFab{display:none!important} }
#mobOv{display:none;position:fixed;top:0;left:0;right:0;bottom:0;width:100vw;height:100vh;height:100dvh;z-index:99999;background:#f0f4f8;overflow-y:auto;-webkit-overflow-scrolling:touch}
#mobOv.show{display:block}
#mobOvHeader{background:linear-gradient(135deg,#0a1220,#0d4f4a);padding:calc(20px + env(safe-area-inset-top)) 16px 18px}
#mobOvKpis{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:14px}
.mob-kpi{background:rgba(255,255,255,.12);border-radius:10px;padding:9px 4px;text-align:center;color:#fff}
.mob-kpi b{display:block;font-size:22px;font-weight:900;line-height:1;font-family:Arial,sans-serif}
.mob-kpi span{display:block;font-size:9px;opacity:.65;margin-top:3px;letter-spacing:.05em;text-transform:uppercase}
#mobOvGrid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:14px 14px calc(80px + env(safe-area-inset-bottom))}
.mob-btn{appearance:none;-webkit-appearance:none;background:#fff;border:1.5px solid #e2e8f0;border-radius:16px;padding:18px 12px 14px;text-align:left;cursor:pointer;font-family:inherit;display:flex;flex-direction:column;gap:5px;box-shadow:0 2px 8px rgba(15,23,42,.05);-webkit-tap-highlight-color:rgba(13,148,136,.25);touch-action:manipulation;user-select:none;-webkit-user-select:none}
.mob-btn:active{background:#ecfdf5;border-color:#0d9488;transform:scale(.98)}
.mob-btn .mb-i{font-size:28px;line-height:1.1}
.mob-btn .mb-n{font-size:14px;font-weight:800;color:#0f1923;line-height:1.2}
.mob-btn .mb-s{font-size:11px;color:#6b7280;font-weight:500}
#mobHomeFab{display:none;position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom));transform:translateX(-50%);z-index:99998;background:#0a1220;color:#fff;border:0;padding:13px 30px;border-radius:99px;font-size:15px;font-weight:700;font-family:inherit;box-shadow:0 4px 24px rgba(0,0,0,.4);cursor:pointer;white-space:nowrap;-webkit-tap-highlight-color:rgba(255,255,255,.2);touch-action:manipulation}
#mobHomeFab.show{display:block}
#mobHomeFab:active{transform:translateX(-50%) scale(.96)}
#shareToMobile{display:none}
@media(min-width:801px){
  #shareToMobile{display:flex;align-items:center;gap:10px;background:linear-gradient(135deg,#0d9488,#0891b2);color:#fff;padding:10px 16px;border-radius:10px;font-size:13px;font-weight:600;cursor:pointer;border:0;font-family:inherit}
}
