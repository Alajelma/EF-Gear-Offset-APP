function consumeMaterials(o){if(o._consumed)return; (o.materials||[]).forEach(x=>{const m=getMaterial(x.id); if(m)m.stock=Math.max(0,Number(m.stock||0)-Number(x.qty||0))}); o._consumed=true}
function restoreMaterials(o,materialsOverride=null){if(!o._consumed)return; (materialsOverride||o.materials||[]).forEach(x=>{const m=getMaterial(x.id); if(m)m.stock=Number(m.stock||0)+Number(x.qty||0)}); o._consumed=false}
function applyOrderSideEffects(o,oldStatus='',oldMaterialsJson='[]'){if(o.status==='Abgeschlossen'){if(oldStatus==='Abgeschlossen'&&oldMaterialsJson!==JSON.stringify(o.materials||[])){try{restoreMaterials({...o,_consumed:true},JSON.parse(oldMaterialsJson||'[]'))}catch(e){}} o.completedAt=o.completedAt||todayISO(); if(oldStatus!=='Abgeschlossen')learnFromOrder(o); consumeMaterials(o)} else {if(oldStatus==='Abgeschlossen'){try{restoreMaterials(o,JSON.parse(oldMaterialsJson||'[]'))}catch(e){restoreMaterials(o)}; o.completedAt=''}}}

function autoPlanOrders(){const start=document.getElementById('plannerStart').value||startOfWeek(); let dayIndex=0; state.orders.filter(o=>o.status!=='Abgeschlossen').sort((a,b)=>priorityScore(b.priority)-priorityScore(a.priority)).forEach(o=>{const old=o.status, oldM=JSON.stringify(o.materials||[]); const s=suggestEmployee(o); if(s.employee)o.assignedEmployeeId=s.employee.id; if(!o.plannedStart){for(let i=0;i<14;i++){const d=addDays(start,(dayIndex+i)%14); if(!isAbsent(o.assignedEmployeeId,d)){o.plannedStart=d; dayIndex++; break}}} if(o.status==='Neu')o.status='Geplant'; o.materials=autoMaterialPlan(o,o.materials||[]); o.updatedAt=new Date().toISOString(); applyOrderSideEffects(o,old,oldM)}); saveState(true); liveRefresh('autoPlan'); toast('Aufträge automatisch vorgeschlagen, geplant und Material reserviert')}
function isAbsent(empId,date){return state.absences.some(a=>a.employeeId===empId&&a.from<=date&&a.to>=date)}
function renderPlanner(){const start=document.getElementById('plannerStart')?.value||startOfWeek(), weeks=Number(document.getElementById('plannerWeeks')?.value||1); state.settings.plannerStart=start; state.settings.plannerWeeks=weeks; const days=weeks*7, viewEnd=addDays(start,days-1); document.getElementById('plannerGrid').style.setProperty('--days',days); document.getElementById('plannerTitle').textContent=`Wochenplanung Jimmy's Firma · KW ${weekNo(start)}${weeks>1?' bis KW '+weekNo(viewEnd):''}`; document.getElementById('plannerLegend').innerHTML=statuses.map(s=>`<span class="pill status-pill ${statusClass[s]}">${s}</span>`).join('')+'<span class="pill" style="background:#f59e0b;color:#fff">Ferien</span><span class="pill" style="background:#dc2626;color:#fff">Krankheit</span>'; const filterEmp=document.getElementById('plannerEmployeeFilter')?.value||'all', filterStatus=document.getElementById('plannerStatusFilter')?.value||'active'; const empList=state.employees.filter(e=>e.active&&(filterEmp==='all'||e.id===filterEmp)); let html='<div class="planner-header"><div class="planner-name">Mitarbeiter</div>'; for(let i=0;i<days;i++){const d=addDays(start,i); html+=`<div><b>${['Mo','Di','Mi','Do','Fr','Sa','So'][i%7]}</b><br><span class="small">${fmtDate(d)} · KW ${weekNo(d)}</span></div>`} html+='</div>'; empList.forEach(emp=>{const todayAbs=currentAbsences().find(a=>a.employeeId===emp.id); html+=`<div class="planner-row"><div class="planner-name"><span class="avatar">${esc(emp.lastName||'?').slice(0,2)}</span> ${esc(empName(emp))}<br><span class="small">Stufe ${emp.level} · ${stars(avgRating(emp))}${todayAbs?' · '+esc(todayAbs.type):''}</span></div>`; for(let i=0;i<days;i++){const d=addDays(start,i), weekend=i%7>=5; html+=`<div class="day-cell ${weekend?'weekend':''}" data-emp="${emp.id}" data-date="${d}" ondragover="plannerDragOver(event)" ondragleave="plannerDragLeave(event)" ondrop="plannerDrop(event)">`; state.absences.filter(a=>a.employeeId===emp.id&&a.from<=d&&a.to>=d).forEach(abs=>{const first=abs.from>start?abs.from:start; if(d===first)html+=absenceBar(abs,first,viewEnd)}); ordersForCell(emp.id,d,filterStatus).forEach(o=>html+=planBar(o)); html+='</div>'} html+='</div>'}); document.getElementById('plannerGrid').innerHTML=html; const pool=state.orders.filter(o=>o.status!=='Abgeschlossen'&&(!o.assignedEmployeeId||!o.plannedStart)); document.getElementById('pool').innerHTML=pool.length?pool.map(orderCard).join(''):'<div class="order-card okline">Alle aktiven Aufträge sind zugeteilt und geplant.</div>'}
function absenceBar(abs,first,viewEnd){const last=abs.to<viewEnd?abs.to:viewEnd, span=Math.max(1,daysBetween(first,last)+1), cls=abs.type==='Krankheit'?'krankheit':'ferien'; return `<div class="absence-bar ${cls}" style="width:calc(${span} * 100% + ${Math.max(0,span-1)}px - 8px)">${esc(abs.type)}<small>${fmtDate(abs.from)} bis ${fmtDate(abs.to)} · ${esc(abs.note||'')}</small></div>`}
function ordersForCell(empId,date,filterStatus){return state.orders.filter(o=>o.assignedEmployeeId===empId&&o.plannedStart===date&&o.status!=='Abgeschlossen'&&(filterStatus==='active'||filterStatus==='all'||o.status===filterStatus))}
function planBar(o){return `<div class="plan-bar ${statusClass[o.status]}" draggable="true" ondragstart="dragOrder(event,'${o.id}')" onclick="if(event.target.closest('button')||event.target.closest('.resize-handle'))return; openOrderModal('${o.id}')" style="width:calc(${Math.max(1,Number(o.plannedDays||1))} * 100% + ${Math.max(0,Math.max(1,Number(o.plannedDays||1))-1)}px - 8px)">${esc(o.orderNo)} · ${esc(o.customer||'')}<small>${esc(o.category)} · ${o.runningMeters||0} lm · ${o.plannedHours||0} h · ${Math.max(1,Number(o.plannedDays||1))} Tag(e)</small><div class="bar-tools no-print"><button onclick="changePlanDays(event,'${o.id}',-1)">−</button><button onclick="changePlanDays(event,'${o.id}',1)">+</button></div><span class="resize-handle no-print" onpointerdown="startResizeBar(event,'${o.id}')" title="Ziehen zum Verlängern/Kürzen"></span></div>`}
function scalePlannedHours(o,oldDays,newDays){const h=Number(o.plannedHours||oldDays*8||8); o.plannedHours=Math.max(0.5,Math.round((h/Math.max(1,oldDays))*Math.max(1,newDays)*10)/10)}
function changePlanDays(ev,id,delta){ev.stopPropagation(); const o=getOrder(id); if(o){const oldDays=Math.max(1,Number(o.plannedDays||1)); o.plannedDays=Math.max(1,oldDays+delta); scalePlannedHours(o,oldDays,o.plannedDays); o.updatedAt=new Date().toISOString(); saveState(true); liveRefresh('planDays'); toast('Balken angepasst: '+o.plannedDays+' Tag(e)')}}
function startResizeBar(ev,id){ev.preventDefault(); ev.stopPropagation(); const bar=ev.currentTarget.closest('.plan-bar'), cell=bar?.closest('.day-cell'), o=getOrder(id); if(!bar||!cell||!o)return; const startX=ev.clientX, startDays=Math.max(1,Number(o.plannedDays||1)), startHours=Number(o.plannedHours||startDays*8||8), dayW=Math.max(42,cell.getBoundingClientRect().width); bar.classList.add('resizing'); const move=e=>{const delta=Math.round((e.clientX-startX)/dayW); const days=Math.max(1,startDays+delta); const hours=Math.max(0.5,Math.round((startHours/startDays)*days*10)/10); bar.dataset.days=days; bar.style.width=`calc(${days} * ${dayW}px - 8px)`; const sm=bar.querySelector('small'); if(sm)sm.textContent=`${o.category||''} · ${o.runningMeters||0} lm · ${hours} h · ${days} Tag(e)`}; const up=e=>{const delta=Math.round((e.clientX-startX)/dayW); const old=startDays; o.plannedDays=Math.max(1,startDays+delta); o.plannedHours=Math.max(0.5,Math.round((startHours/old)*o.plannedDays*10)/10); o.updatedAt=new Date().toISOString(); bar.classList.remove('resizing'); window.removeEventListener('pointermove',move); window.removeEventListener('pointerup',up); saveState(true); liveRefresh('resizeBar'); toast('Balken-Dauer angepasst und Planung aktualisiert')}; window.addEventListener('pointermove',move); window.addEventListener('pointerup',up)}
function dragOrder(ev,id){draggedOrderId=id; ev.dataTransfer.setData('text/plain',id)}
function plannerDragOver(ev){ev.preventDefault(); ev.currentTarget.classList.add('drop-hover')}
function plannerDragLeave(ev){ev.currentTarget.classList.remove('drop-hover')}
function plannerDrop(ev){ev.preventDefault(); ev.currentTarget.classList.remove('drop-hover'); const id=ev.dataTransfer.getData('text/plain')||draggedOrderId, o=getOrder(id); if(!o)return; const old=o.status, oldM=JSON.stringify(o.materials||[]); o.assignedEmployeeId=ev.currentTarget.dataset.emp; o.plannedStart=ev.currentTarget.dataset.date; if(o.status==='Neu')o.status='Geplant'; o.materials=autoMaterialPlan(o,o.materials||[]); o.updatedAt=new Date().toISOString(); applyOrderSideEffects(o,old,oldM); saveState(true); liveRefresh('plannerDrop'); toast('Auftrag geplant, Material reserviert und Logik aktualisiert')}
