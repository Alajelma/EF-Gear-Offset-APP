<button type="button" id="mobHomeFab">🏠 Home</button>

<script>
(function(){
  function isMob(){ return window.innerWidth <= 800; }
  var ov, fab;
  function showHome(){
    if(!ov||!fab)return;
    ov.classList.add('show'); fab.classList.remove('show');
    document.body.classList.add('mob-home-open');
    refreshKpis();
    if(window.scrollTo)window.scrollTo(0,0);
  }
  function showSec(id){
    if(!ov||!fab)return;
    ov.classList.remove('show'); fab.classList.add('show');
    document.body.classList.remove('mob-home-open');
    try{
      var secs=document.querySelectorAll('.section');
      for(var i=0;i<secs.length;i++) secs[i].classList.toggle('active',secs[i].id===id);
    }catch(e){}
    try{ if(id==='chef'){renderKpis();renderWarnings();setTimeout(renderCharts,80);} }catch(e){}
    try{ if(id==='orders')renderOrders(); }catch(e){}
    try{ if(id==='inquiries')renderInquiries(); }catch(e){}
    try{ if(id==='planner')renderPlanner(); }catch(e){}
    try{ if(id==='completed')renderCompletedOrders(); }catch(e){}
    try{ if(id==='employees')renderEmployees(); }catch(e){}
    try{ if(id==='materials'){renderMaterials();setTimeout(renderCharts,80);} }catch(e){}
    try{ if(id==='absence')renderAbsences(); }catch(e){}
    try{ if(id==='stats')setTimeout(function(){renderCharts();renderEmployeeDetail();},80); }catch(e){}
    try{ if(id==='reviews')renderReviews(); }catch(e){}
    try{ if(id==='communication')generateMailText(); }catch(e){}
    try{ if(id==='teams')renderTeams(); }catch(e){}
    try{ if(id==='backup')renderBackupInfo(); }catch(e){}
    if(window.scrollTo)window.scrollTo(0,0);
  }
  function refreshKpis(){
    try{
      if(typeof state==='undefined')return;
      var a=state.orders.filter(function(o){return o.status!=='Abgeschlossen';}).length;
      var c=state.orders.filter(function(o){return o.status==='Reklamation'||o.complaint;}).length;
      var m=state.materials.filter(function(x){return Number(x.stock)<=Number(x.min);}).length;
      var el=document.getElementById('mobOvKpis');
      if(!el)return;
      el.innerHTML='<div class="mob-kpi"><b>'+a+'</b><span>Auftraege</span></div>'+
        '<div class="mob-kpi" style="'+(c?'background:rgba(220,38,38,.4)':'')+'"><b>'+c+'</b><span>Reklist.</span></div>'+
        '<div class="mob-kpi" style="'+(m?'background:rgba(217,119,6,.4)':'')+'"><b>'+m+'</b><span>Material</span></div>';
    }catch(e){}
  }
  function handleTap(e){
    if(!isMob())return;
    var n=e.target;
    for(var i=0;i<5 && n;i++){
      if(n.getAttribute){
        var go=n.getAttribute('data-go');
        if(go){e.preventDefault();e.stopPropagation();showSec(go);return;}
        if(n.id==='mobHomeFab'){e.preventDefault();e.stopPropagation();showHome();return;}
      }
      n=n.parentElement;
    }
  }
  function init(){
    ov=document.getElementById('mobOv');
    fab=document.getElementById('mobHomeFab');
    document.addEventListener('click',handleTap,true);
    document.addEventListener('touchend',handleTap,{passive:false,capture:true});
    if(isMob())showHome();
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);
  else init();
  setTimeout(function(){
    if(ov && isMob() && !ov.classList.contains('show') && !fab.classList.contains('show'))showHome();
    else refreshKpis();
  },800);
})();
</script>

