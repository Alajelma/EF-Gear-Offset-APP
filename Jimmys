function renderCharts(){if(typeof Chart==='undefined')return; renderReportControls(); const orders=filterReportOrders(); const base={responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom'},title:{display:true,text:'Zeitraum: '+reportLabel()}},layout:{padding:6},scales:{x:{ticks:{autoSkip:true,maxRotation:35}},y:{beginAtZero:true}}}; const make=(id,type,data,opts={})=>{const ctx=document.getElementById(id); if(!ctx)return; if(charts[id])charts[id].destroy(); const round=type==='doughnut'||type==='pie'; const options=round?{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom'},title:{display:true,text:'Zeitraum: '+reportLabel()}}}:{...base,...opts}; charts[id]=new Chart(ctx,{type,data,options})}; const q={}; orders.forEach(o=>q[reportGroupKey(orderReportDate(o))]=(q[reportGroupKey(orderReportDate(o))]||0)+1); make('chartQuarter','bar',chartDataSafe(Object.keys(q),Object.values(q),'Aufträge')); const st={}; orders.forEach(o=>st[o.status]=(st[o.status]||0)+1); make('chartStatus','doughnut',chartDataSafe(Object.keys(st),Object.values(st),'Status')); const mw=state.materials.filter(m=>Number(m.stock)<=Number(m.min)); make('chartMaterialWarn','bar',chartDataSafe(mw.map(m=>m.name),mw.map(m=>m.stock),'Materialwarnungen Bestand'),{indexAxis:mw.length>5?'y':'x'}); const meters={}; orders.filter(o=>o.status==='Abgeschlossen').forEach(o=>meters[empName(getEmp(o.assignedEmployeeId)||{lastName:'Offen'})]=(meters[empName(getEmp(o.assignedEmployeeId)||{lastName:'Offen'})]||0)+Number(o.runningMeters||0)); const top=Object.entries(meters).sort((a,b)=>b[1]-a[1]).slice(0,12); make('chartEmployeeMeters','bar',chartDataSafe(top.map(x=>x[0]),top.map(x=>x[1]),'Laufmeter abgeschlossen'),{indexAxis:top.length>5?'y':'x',scales:{x:{beginAtZero:true},y:{ticks:{autoSkip:false}}}}); const comp={}; orders.filter(o=>o.complaint||o.status==='Reklamation').forEach(o=>comp[empName(getEmp(o.assignedEmployeeId)||{lastName:'Offen'})]=(comp[empName(getEmp(o.ass