async function shareBlobFile(blob,name,title,text){
  try{
    const file=new File([blob],name,{type:blob.type||'application/pdf'});
    if(navigator.share&&navigator.canShare&&navigator.canShare({files:[file]})){
      await navigator.share({title,text,files:[file]});
      toast('Teilen geöffnet');
      return;
    }
  }catch(e){}
  downloadBlob(blob,name);
  const msg=encodeURIComponent((text||title||'Export')+'\n\nPDF wurde heruntergeladen und kann in WhatsApp oder Outlook angehängt werden.');
  window.open('https://wa.me/?text='+msg,'_blank');
  toast('PDF heruntergeladen und WhatsApp-Text vorbereitet');
}
