<style>
:root{
  --bg:#f0f4f8;--card:#fff;--ink:#0f1923;--muted:#5c6b7a;--line:#e2e8f0;
  --dark:#0a1220;--brand:#0d9488;--brand2:#0891b2;--soft:#f0fdfa;
  --neu:#64748b;--plan:#2563eb;--work:#0891b2;--clar:#d97706;--done:#16a34a;--red:#dc2626;
  --shadow:0 4px 24px rgba(15,23,42,.07),0 1px 4px rgba(15,23,42,.04);
  --shadow-lg:0 12px 40px rgba(15,23,42,.12);
  --r:14px;--r-sm:10px;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:var(--ink);font-family:'DM Sans',system-ui,-apple-system,Segoe UI,Arial,sans-serif;font-size:14px;line-height:1.5;overflow-x:hidden}
button,input,select,textarea{font:inherit}
button{border:0;border-radius:var(--r-sm);padding:8px 14px;font-weight:700;cursor:pointer;background:#eef2f7;color:var(--ink);transition:all .15s ease;font-size:13px}
button:hover{background:#e2e8f0;box-shadow:0 2px 8px rgba(15,23,42,.1)}
button:active{transform:scale(.98)}
.btn-primary{background:linear-gradient(135deg,var(--brand),var(--brand2));color:#fff;box-shadow:0 2px 12px rgba(13,148,136,.3)}
.btn-primary:hover{box-shadow:0 4px 18px rgba(13,148,136,.4);background:linear-gradient(135deg,#0b8078,#0780a2)}
.btn-dark{background:#111827;color:#fff}.btn-dark:hover{background:#1f2937}
.btn-ok{background:#dcfce7;color:#166534}.btn-ok:hover{background:#bbf7d0}
.btn-danger{background:#fee2e2;color:#991b1b}.btn-danger:hover{background:#fecaca}
.btn-warn{background:#fef3c7;color:#92400e}.btn-warn:hover{background:#fde68a}
.btn-mini{font-size:12px;padding:5px 9px;border-radius:8px}
input,select,textarea{width:100%;border:1.5px solid var(--line);background:#fff;border-radius:var(--r-sm);padding:8px 11px;outline:none;transition:border-color .15s,box-shadow .15s;color:var(--ink)}
input:focus,select:focus,textarea:focus{border-color:var(--brand);box-shadow:0 0 0 3px rgba(13,148,136,.12)}
textarea{min-height:80px;resize:vertical}
label{display:block;font-size:11.5px;font-weight:700;color:#6b7280;margin:4px 0 5px;letter-spacing:.01em;text-transform:uppercase}
.small{font-size:12px;color:var(--muted);line-height:1.4}
h1,h2,h3{margin:0 0 8px;line-height:1.2;font-weight:800}
h2{font-size:16px}h3{font-size:14px}
.hide{display:none!important}.no-print{}
/* App ist immer sichtbar – Loader liegt als Overlay drüber */


/* ── LOADER ── */
#loader{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;text-align:center;color:#fff;background:linear-gradient(145deg,#061018,#0c1f1e 50%,#061018);animation:loaderAutoHide 0.4s ease 2.5s forwards}
@keyframes loaderAutoHide{0%{opacity:1;pointer-events:auto}100%{opacity:0;pointer-events:none;visibility:hidden}}
#loader:before{content:"";position:absolute;inset:0;background:radial-gradient(ellipse 60% 50% at 30% 30%,rgba(13,148,136,.25),transparent),radial-gradient(ellipse 40% 40% at 70% 70%,rgba(8,145,178,.2),transparent)}
.loader-card{position:relative;padding:44px 52px;border:1px solid rgba(255,255,255,.15);border-radius:28px;background:rgba(255,255,255,.1);box-shadow:0 40px 80px rgba(0,0,0,.4)}
.loader-logo{width:64px;height:64px;margin:0 auto 20px;border-radius:20px;background:linear-gradient(135deg,var(--brand),#0c3d56);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:24px;color:#fff;box-shadow:0 8px 24px rgba(13,148,136,.4)}
.loader-title{font-size:clamp(22px,4vw,44px);line-height:1.1;font-weight:900;letter-spacing:.02em;text-transform:uppercase}
.loader-title span{display:block;opacity:.65;font-size:.65em;letter-spacing:.06em;margin-top:4px}
.loader-sub{margin-top:14px;color:#7eeae3;font-weight:700;font-size:12px;letter-spacing:.2em;text-transform:uppercase}
.loader-line{height:3px;margin:22px auto 0;width:200px;border-radius:99px;background:rgba(255,255,255,.12);overflow:hidden}
.loader-line span{display:block;height:100%;width:45%;background:linear-gradient(90deg,transparent,#5eead4,transparent);border-radius:99px;animation:loadbar 1.4s ease-in-out infinite}
@keyframes loadbar{0%{transform:translateX(-120%)}100%{transform:translateX(300%)}}

/* ── HEADER ── */
header{position:sticky;top:0;z-index:50;background:rgba(240,244,248,.95);border-bottom:1px solid var(--line)}
.topbar{max-width:1560px;margin:0 auto;padding:10px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.brand{display:flex;align-items:center;gap:11px}
.logo{width:44px;height:44px;border-radius:13px;background:linear-gradient(135deg,var(--brand),#0c3d56);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:17px;flex-shrink:0;box-shadow:0 4px 12px rgba(13,148,136,.3)}
.brand-title{font-weight:900;line-height:1.1;font-size:13px}
.brand-title span{display:block;color:var(--muted);font-weight:500;font-size:11px;margin-top:1px}
.brand-meta{font-size:11px;color:var(--muted);font-weight:500;margin-top:1px}
.top-actions{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.save-dot{width:8px;height:8px;border-radius:99px;background:#22c55e;display:inline-block;margin-right:5px;vertical-align:middle}
.save-dot.dirty{background:#f59e0b;animation:pulseDot .9s infinite}
@keyframes pulseDot{50%{opacity:.3}}

/* ── TABS ── */
.tabs{max-width:1560px;margin:0 auto;display:flex;gap:4px;overflow:auto;padding:8px 18px;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{background:transparent;border:1.5px solid transparent;white-space:nowrap;padding:7px 13px;font-size:12.5px;font-weight:600;color:var(--muted);border-radius:9px;transition:all .15s}
.tab:hover{background:#e2e8f0;color:var(--ink)}
.tab.active{background:#0a1220;color:#fff;border-color:#0a1220;box-shadow:0 2px 8px rgba(10,18,32,.25)}

/* ── LAYOUT ── */
.container{max-width:1560px;margin:0 auto;padding:18px}
.section{display:none}.section.active{display:block}
.grid{display:grid;gap:14px}
.grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}
.grid-3{grid-template-columns:repeat(3,minmax(0,1fr))}
.grid-4{grid-template-columns:repeat(4,minmax(0,1fr))}
.grid-5{grid-template-columns:repeat(5,minmax(0,1fr))}

/* ── CARDS ── */
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);padding:18px;min-width:0}
.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:14px}
.toolbar,.actions{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.list{display:grid;gap:9px}

/* ── KPI CARDS ── */
.kpi{display:flex;flex-direction:column;gap:4px;position:relative;overflow:hidden}
.kpi::before{content:'';position:absolute;top:-10px;right:-10px;width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,rgba(13,148,136,.07),rgba(8,145,178,.07))}
.kpi b{font-size:32px;font-weight:900;line-height:1;font-family:'DM Mono',monospace}
.kpi span{font-size:11.5px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.04em}

/* ── PILLS / STATUS ── */
.pill{display:inline-flex;align-items:center;gap:4px;border-radius:99px;padding:4px 10px;font-size:11.5px;font-weight:700;background:#eef2ff;color:#3730a3}
.status-pill{color:#fff}
.status-Neu{background:var(--neu)!important}
.status-Geplant{background:var(--plan)!important}
.status-In-Arbeit{background:var(--work)!important}
.status-In-Abklaerung{background:var(--clar)!important}
.status-Abgeschlossen{background:var(--done)!important}
.status-Reklamation{background:var(--red)!important}

/* ── ORDER CARDS ── */
.order-card{border:1px solid var(--line);border-radius:12px;padding:13px 14px;background:#fff;display:grid;gap:8px;transition:box-shadow .15s}
.order-card:hover{box-shadow:0 4px 16px rgba(15,23,42,.09)}
.order-card.dragging{opacity:.45}
.order-title{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:13.5px}
.order-meta{display:flex;gap:6px;flex-wrap:wrap}
.warning{border-left:4px solid var(--clar);background:#fffbeb}
.dangerline{border-left:4px solid var(--red);background:#fff5f5}
.okline{border-left:4px solid var(--done);background:#f0fdf4}

/* ── DROPZONE ── */
.dropzone{border:2px dashed #cbd5e1;border-radius:14px;background:#f8fafc;padding:20px;text-align:center;transition:all .2s;color:var(--muted)}
.dropzone b{color:var(--ink)}
.dropzone.dragover{background:#ecfeff;border-color:var(--brand);color:var(--brand)}

/* ── TABLE ── */
table{width:100%;border-collapse:separate;border-spacing:0}
th,td{text-align:left;padding:9px 11px;border-bottom:1px solid var(--line);vertical-align:top}
th{font-size:11.5px;color:#6b7280;background:#f8fafc;position:sticky;top:0;z-index:1;font-weight:700;text-transform:uppercase;letter-spacing:.04em}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:12px;background:#fff}
.compact-table th,.compact-table td{font-size:12px;padding:7px 10px}

/* ── AVATAR / STARS ── */
.avatar{width:34px;height:34px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:#e0f2fe;color:#075985;font-weight:800;font-size:12px;flex-shrink:0}
.stars{color:#f59e0b;letter-spacing:1px}

/* ── CHARTS ── */
.chart-grid{display:grid;gap:14px;min-width:0}
.chart-grid-2{grid-template-columns:repeat(2,minmax(0,1fr))}
.chart-grid-3{grid-template-columns:repeat(3,minmax(0,1fr))}
.chart-box{position:relative;min-width:0;height:260px;border:1px solid var(--line);border-radius:12px;background:#fff;padding:12px;overflow:hidden}
.chart-box canvas{display:block!important;width:100%!important;height:100%!important;max-width:100%!important}
.report-controls{border:1px solid var(--line);border-radius:12px;background:#f8fafc;padding:12px;margin:10px 0 14px}
.report-label{font-weight:700;color:var(--ink)}

/* ── PLANNER ── */
.planner-wrap{overflow:auto;border:1px solid var(--line);border-radius:14px;background:#fff}
.planner{min-width:1180px}
.planner-header,.planner-row{display:grid;grid-template-columns:220px repeat(var(--days),minmax(96px,1fr));border-bottom:1px solid var(--line)}
.planner-header{position:sticky;top:0;z-index:5;background:#f8fafc}
.planner-header div,.planner-name,.day-cell{padding:9px;border-right:1px solid var(--line);min-height:48px}
.planner-name{background:#fbfdff;font-weight:800;position:sticky;left:0;z-index:4;font-size:13px}
.planner-header .planner-name{z-index:8}
.day-cell{position:relative;min-height:92px}
.day-cell.weekend{background:#f9fafb}
.day-cell.drop-hover{background:#ecfeff;outline:2px solid var(--brand);outline-offset:-2px}
.plan-bar,.absence-bar{position:relative;z-index:3;margin:3px 0;border-radius:10px;color:#fff;padding:6px 9px;min-height:36px;font-size:12px;font-weight:700;box-shadow:0 2px 8px rgba(0,0,0,.18);overflow:hidden}
.plan-bar small,.absence-bar small{display:block;font-weight:500;opacity:.9;font-size:11px}
.absence-bar{background:#d97706}.absence-bar.krankheit{background:#dc2626}
.bar-tools{display:flex;gap:3px;position:absolute;right:18px;top:5px}
.bar-tools button{padding:1px 5px;border-radius:6px;background:rgba(255,255,255,.28);color:#fff;font-size:11px;font-weight:700}
.resize-handle{position:absolute;right:0;top:0;bottom:0;width:14px;cursor:ew-resize;background:rgba(255,255,255,.2);border-left:1px solid rgba(255,255,255,.25)}
.resize-handle:after{content:'↔';position:absolute;right:2px;top:50%;transform:translateY(-50%);font-size:10px}
.plan-bar.resizing{outline:3px solid rgba(20,184,166,.5)}
.report-controls .custom-date{display:none}.report-controls.custom .custom-date{display:block}
.pool{display:flex;gap:10px;overflow:auto;padding-bottom:6px}
.pool .order-card{min-width:280px;flex-shrink:0}

/* ── MODAL ── */
.modal{position:fixed;inset:0;background:rgba(10,18,32,.5);display:none;align-items:center;justify-content:center;z-index:90;padding:18px}
.modal.open{display:flex}
.modal-panel{background:#fff;border-radius:20px;box-shadow:0 30px 80px rgba(0,0,0,.22);max-width:1080px;width:100%;max-height:92vh;overflow:auto;padding:20px}
.modal-head{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px;padding-bottom:12px;border-bottom:1px solid var(--line)}
.modal-head h2{font-size:17px}
.form-footer{position:sticky;bottom:0;background:#fff;border-top:1px solid var(--line);padding-top:12px;margin-top:14px}

/* ── MISC ── */
.file-chip{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:8px 11px;border:1px solid var(--line);border-radius:10px;background:#fff;font-size:13px}
.emailbox{white-space:pre-wrap;background:#0b1220;color:#d8f3f0;border-radius:12px;padding:14px;min-height:160px;font-family:'DM Mono',monospace;font-size:13px;line-height:1.6}
.toast{position:fixed;right:16px;bottom:16px;background:#0f172a;color:#fff;border-radius:12px;padding:11px 16px;box-shadow:var(--shadow-lg);z-index:120;display:none;max-width:360px;font-size:13.5px;font-weight:500;animation:slideUp .2s ease}
@keyframes slideUp{from{transform:translateY(8px);opacity:0}to{transform:translateY(0);opacity:1}}
.toast.show{display:block}
.inline-save-flash{animation:flashSave .8s ease}
@keyframes flashSave{0%{box-shadow:0 0 0 3px rgba(13,148,136,.3)}100%{box-shadow:var(--shadow)}}

/* ── RESPONSIVE ── */
@media(max-width:900px){
  .topbar{align-items:flex-start;flex-direction:column}
  .top-actions{width:100%}.top-actions button{flex:1}
  .container{padding:12px}
  .grid-2,.grid-3,.grid-4,.grid-5,.chart-grid-2,.chart-grid-3{grid-template-columns:1fr}
  .card{padding:14px;border-radius:12px}.card-head{flex-direction:column}
  .tabs{padding:6px 12px}.tab{font-size:12px;padding:6px 10px}
  .brand-title{font-size:13px}.logo{width:40px;height:40px}
  .chart-box{height:230px}
  .modal{padding:8px}.modal-panel{border-radius:16px;padding:14px}
  .planner{min-width:980px}
  .planner-header,.planner-row{grid-template-columns:150px repeat(var(--days),minmax(86px,1fr))}
  .planner-name{font-size:12px}.toolbar button{flex:1}
  .kpi b{font-size:26px}
}

@media print{
  header,.tabs,.no-print,.actions,.toolbar,button{display:none!important}
  .container{max-width:none;padding:0}.section{display:block}
  .card{box-shadow:none;border:1px solid #ccc;break-inside:avoid}
  .planner-wrap{overflow:visible}.planner{min-width:0}.modal{display:none!important}
}

/* === v3.0 / v3.1 Komponenten – bereinigt & verbessert === */
.ai-strip{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:14px;margin-top:14px}
.ai-card{background:#fff;border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);padding:14px;min-width:0}
.ai-card.dark{background:linear-gradient(135deg,#0f172a,#134e4a);color:#fff;border-color:transparent;box-shadow:var(--shadow-lg)}.ai-card.dark .small{color:#a7f3eb}
.ai-card.warn{background:#fffbeb;border-color:#fde68a}
.ai-card.danger{background:#fff5f5;border-color:#fecaca}
.ai-title{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:9px}
.ai-title b{font-size:14px;font-weight:800}
.ai-list{display:grid;gap:8px}
.ai-hint{border:1px solid rgba(15,23,42,.07);background:rgba(248,250,252,.9);border-radius:10px;padding:9px;font-size:13px}
.ai-card.dark .ai-hint{background:rgba(255,255,255,.08);border-color:rgba(255,255,255,.14)}
.inquiry-card{border:1px solid var(--line);border-radius:12px;background:#fff;box-shadow:var(--shadow);padding:14px;display:grid;gap:9px}
.inquiry-card.reklamation{border-left:4px solid var(--red)}
.inquiry-card.offer{border-left:4px solid var(--brand2)}
.inquiry-card.open{border-left:4px solid var(--clar)}
.inquiry-ai{display:grid;gap:6px}.inquiry-ai .ai-hint{font-size:12px}
.response-box{white-space:pre-wrap;background:#0b1220;color:#d8f3f0;border-radius:12px;padding:13px;min-height:130px;font-family:'DM Mono',monospace;font-size:12.5px;line-height:1.6}
.birthday-pop{position:fixed;inset:0;z-index:140;display:none;align-items:center;justify-content:center;background:rgba(10,18,32,.45)}
.birthday-pop.open{display:flex}
.birthday-card{position:relative;max-width:500px;width:calc(100% - 28px);border-radius:24px;background:#fff;box-shadow:var(--shadow-lg);padding:28px;text-align:center;border:1px solid #a7f3d0;overflow:hidden}
.birthday-card h2{font-size:26px}
.confetti-piece{position:absolute;width:8px;height:14px;top:-30px;border-radius:3px;animation:confettiFall 3s linear infinite}
.confetti-piece:nth-child(3n){background:#14b8a6}.confetti-piece:nth-child(3n+1){background:#f59e0b}.confetti-piece:nth-child(3n+2){background:#0ea5e9}
@keyframes confettiFall{0%{transform:translateY(-30px) rotate(0deg);opacity:1}100%{transform:translateY(600px) rotate(680deg);opacity:0}}
